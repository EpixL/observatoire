# Copier en .env (ou saisir dans Portainer). VALEURS FACTICES : aucun secret réel ne doit être commité.

# --- Base de données (utiliser un mot de passe alphanumérique : il est inséré dans une URL) ---
POSTGRES_USER=veille
POSTGRES_PASSWORD=CHANGER-MOI-mot-de-passe-factice
POSTGRES_DB=veille

# --- Stockage persistant : disque Btrfs du homelab (voir docs/runbook.md : chattr +C sur postgres/). Jamais le disque système. ---
DATA_DIR=/mnt/homelab/veille

# --- Réseau : AUCUN port figé dans compose.yaml. Choisir ici un port libre (les conflits seront audités). ---
API_BIND_ADDR=192.168.1.50
API_HOST_PORT=8100

# --- Collecte ---
# Contact placé dans le User-Agent (visible des sites sources). Décision de David : à terme l'URL d'une page de contact (créée au lot 6) ;
# d'ici là « smoke-test ». AUCUNE adresse e-mail personnelle dans ce dépôt.
COLLECTOR_CONTACT=smoke-test
COLLECTOR_JITTER_FRACTION=0.2
COLLECTOR_RESPECT_ROBOTS=true
LOG_LEVEL=INFO

# --- Limites mémoire (Raspberry Pi 5) ---
DB_MEM_LIMIT=768m
APP_MEM_LIMIT=384m

# --- Administration (écritures de l'API : seuils, revue humaine) ---
# Sans ADMIN_TOKEN, les écritures sont DÉSACTIVÉES (réponse 503). Générer un jeton : openssl rand -hex 24  — à ne mettre que dans .env, jamais dans Git.
ADMIN_TOKEN=
ADMIN_ACTOR=David

# --- Jauge et rétention ---
GAUGE_EVAL_INTERVAL_S=300
HISTORY_RETENTION_MONTHS=12
# Sauvegarde (scripts/backup-db.sh)
BACKUP_DIR=/mnt/homelab/@backups/observatoire
