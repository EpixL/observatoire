{
  "name": "veille-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "VEILLE — observatoire de situation : dashboard (maquette sur données fictives)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
