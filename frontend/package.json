    "geo:build": "node scripts/build-geo.mjs",
    "e2e": "playwright test",
    "screenshots": "playwright test e2e/screenshots.spec.ts"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/d3-geo": "3.1.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
