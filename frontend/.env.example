# Port d'écoute du dashboard (conteneur ET serveur de développement).
PORT=8080
# Adresse publiée par Docker : 127.0.0.1 = cet ordinateur seulement ; mettre l'IP LAN du Pi pour l'ouvrir depuis un téléphone.
BIND_ADDRESS=127.0.0.1
# Plus tard, pour brancher la vraie API (même origine uniquement) : VITE_API_BASE=
