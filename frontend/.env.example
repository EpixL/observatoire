# Copier en .env (jamais commité). Aucun secret ici.

# --- Conteneur ---------------------------------------------------------------
# Port d'écoute du dashboard (conteneur ET serveur de développement). Raspberry Pi : 8101.
PORT=8101
# Adresse publiée par Docker : 127.0.0.1 = cet ordinateur seulement ; l'IP LAN du Pi pour ouvrir depuis un téléphone.
BIND_ADDRESS=127.0.0.1
# mock = données fictives (bandeau « DONNÉES FICTIVES ») ; live = API réelle (erreur explicite si elle ne répond pas).
API_MODE=mock
# Hôte:port du backend vu depuis le conteneur. Raspberry Pi : le backend publie 8100 sur l'hôte.
API_UPSTREAM=host.docker.internal:8100
# Résolveur DNS utilisé par le relais /api (Docker : 127.0.0.11).
DNS_RESOLVER=127.0.0.11

# --- Développement (npm run dev / npm run build) ----------------------------
# Équivalents au build : VITE_API_MODE=mock|live ; VITE_API_BASE= (vide = même origine).
# VITE_API_MODE=mock
